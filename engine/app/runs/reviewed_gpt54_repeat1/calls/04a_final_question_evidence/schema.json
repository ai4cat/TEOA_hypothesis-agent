              "teoa_system",
              "method"
            ]
          },
          "question": {
            "type": "string"
          },
          "term_groups": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]+$"
              }
            }
          }
        },
        "required": [
          "id",
          "question_id",
          "channel",
          "question",
          "term_groups"
        ],
        "additionalProperties": false
      }
    }
